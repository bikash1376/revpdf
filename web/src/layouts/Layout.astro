---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'revpdf — a quiet, private PDF & EPUB reader',
  description = 'revpdf is a minimalist offline PDF and EPUB reader for Android. Highlights, reader themes, search and zoom — with no accounts and no servers.',
} = Astro.props;
const year = new Date().getFullYear();
const CONTACT_EMAIL = 'bikash13763@gmail.com';
const ogImage = new URL('/revpdf.jpeg', Astro.site).href;

const footerCols = [
  {
    heading: 'Product',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'FAQ', href: '/#faq' },
      { label: 'Download', href: '/#download' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'Terms of Service', href: '/terms' },
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Feedback', href: `mailto:${CONTACT_EMAIL}?subject=revpdf%20feedback` },
    ],
  },
  {
    heading: 'Connect',
    links: [
      { label: 'Built by Bikash', href: 'https://bksh.site' },
      { label: 'Email', href: `mailto:${CONTACT_EMAIL}` },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Self-hosted Geist + Newsreader (public/fonts) so they always apply. -->
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <img class="brand-logo" src="/revpdf-wordmark.png" alt="revpdf" width="405" height="108" />
      </a>
      <nav class="nav">
        <a href="/#features">Features</a>
        <a href="/#faq">FAQ</a>
        <a class="btn btn-dark" href="/#download">Get Started</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img class="footer-logo" src="/revpdf-wordmark.png" alt="revpdf" width="405" height="108" />
          <p class="muted">A quiet, private reader.<br />Everything stays on your device.</p>
        </div>
        <div class="footer-cols">
          {
            footerCols.map((col) => (
              <div class="footer-col">
                <h4>{col.heading}</h4>
                {col.links.map((l) => (
                  <a href={l.href}>{l.label}</a>
                ))}
              </div>
            ))
          }
        </div>
      </div>
      <p class="copyright muted">© {year} revpdf · revpdf.in</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf8;
    --surface: #ffffff;
    --ink: #14213d;
    --ink-soft: #1f2d4d;
    --body: #4a5568;
    --muted: #6b7280;
    --line: #e8e7e2;
    --card: #f2f3f5;
    --dark: #0e1526;
    --dark-2: #080d18;
    --accent: #3f51b5;

    --radius-sm: 14px;
    --radius-lg: 28px;
    --radius-xl: 36px;
    --shadow-1: 0 1px 2px rgba(20, 33, 61, 0.06), 0 1px 3px rgba(20, 33, 61, 0.08);
    --shadow-2: 0 12px 40px rgba(20, 33, 61, 0.14);
    --maxw: 1120px;
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    font-family: 'Geist', system-ui, -apple-system, sans-serif;
    color: var(--body);
    background: var(--bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  h1,
  h2 {
    font-family: 'Newsreader', Georgia, serif;
    color: var(--ink);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 0.4em;
  }
  h3,
  h4 {
    color: var(--ink);
    line-height: 1.25;
    margin: 0 0 0.4em;
  }
  p {
    margin: 0 0 1em;
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .muted {
    color: var(--muted);
  }
  .lead {
    font-size: clamp(17px, 2.2vw, 20px);
    color: var(--body);
  }
  .material-symbols-outlined {
    font-family: 'Material Symbols Outlined';
    font-weight: normal;
    font-style: normal;
    line-height: 1;
    -webkit-font-feature-settings: 'liga';
    user-select: none;
  }

  /* ---- top bar ---- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px clamp(16px, 5vw, 44px);
    background: rgba(251, 250, 248, 0.82);
    backdrop-filter: saturate(180%) blur(14px);
  }
  .brand {
    display: inline-flex;
    align-items: center;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand-logo {
    height: 44px;
    width: auto;
    display: block;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 32px);
  }
  .nav > a:not(.btn) {
    color: var(--ink-soft);
    font-weight: 500;
    font-size: 15px;
  }
  .nav > a:not(.btn):hover {
    color: var(--ink);
    text-decoration: none;
  }

  /* ---- buttons ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 13px 24px;
    border-radius: 999px;
    font-family: 'Geist', sans-serif;
    font-weight: 600;
    font-size: 15px;
    border: none;
    cursor: pointer;
    transition:
      transform 0.18s ease,
      box-shadow 0.2s ease,
      filter 0.2s ease,
      background 0.2s ease;
  }
  .btn:hover {
    text-decoration: none;
  }
  .btn .material-symbols-outlined {
    font-size: 20px;
  }
  .btn-dark {
    background: var(--dark);
    color: #fff;
    box-shadow: var(--shadow-1);
  }
  .btn-dark:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-2);
  }
  .btn-light {
    background: #fff;
    color: var(--dark);
    box-shadow: var(--shadow-1);
  }
  .btn-light:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-2);
  }
  /* frosted-glass button (hero) */
  .btn-glass {
    background: rgba(255, 255, 255, 0.5);
    color: var(--ink);
    border: 1px solid rgba(20, 33, 61, 0.12);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    box-shadow: 0 1px 2px rgba(20, 33, 61, 0.05);
  }
  .btn-glass:hover {
    background: rgba(255, 255, 255, 0.72);
    transform: translateY(-1px);
    box-shadow: var(--shadow-1);
  }
  /* compact button in the navbar */
  .nav .btn {
    padding: 9px 18px;
    font-size: 14px;
  }

  /* ---- layout helpers ---- */
  main {
    min-height: 60vh;
  }
  .section {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: clamp(44px, 6vw, 84px) clamp(16px, 5vw, 44px);
  }

  /* ---- footer ---- */
  .footer {
    border-top: 1px solid var(--line);
    background: var(--bg);
    margin-top: 8px;
  }
  .footer-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: clamp(40px, 6vw, 64px) clamp(16px, 5vw, 44px) 20px;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(28px, 5vw, 64px);
  }
  .footer-logo {
    height: 40px;
    width: auto;
    display: block;
    margin-bottom: 12px;
  }
  .footer-brand p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    max-width: 240px;
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .footer-col h4 {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 17px;
    font-weight: 500;
    margin-bottom: 14px;
  }
  .footer-col a {
    display: block;
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 11px;
  }
  .footer-col a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .copyright {
    text-align: center;
    font-size: 13px;
    padding: 14px;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  /* ---- responsive ---- */
  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .topbar {
      padding: 12px 16px;
    }
    .nav {
      gap: 14px;
    }
    .nav > a:not(.btn) {
      display: none;
    }
    .footer-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
