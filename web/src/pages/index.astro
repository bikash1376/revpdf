---
import Layout from '../layouts/Layout.astro';

// In development — distributed as a direct APK for now. The Play Store
// listing will replace APK_URL once it's live.
const APK_URL = '/revpdf.apk';
const CONTACT_EMAIL = 'bikash13763@gmail.com';

// Featured hero screenshot from web/public/screenshots/.
const heroShot = '/screenshots/screen-1.gif';

// Feature rows shown next to the "Connect with your library" panel.
const features = [
  { icon: 'menu_book', title: 'PDF & EPUB, done right' },
  { icon: 'ink_highlighter', title: 'Highlight in any color' },
  { icon: 'palette', title: 'Four reading themes' },
  { icon: 'lock', title: 'Private by design' },
];

const faqs = [
  {
    q: 'What is revpdf?',
    a: 'A minimalist, offline PDF & EPUB reader for Android. It keeps the page front and centre — with highlights, reader themes, zoom and search — and nothing you don’t need.',
  },
  {
    q: 'Which file formats does it support?',
    a: 'PDFs and reflowable EPUBs, read in continuous scroll or page-by-page. Pinch to zoom, and tune font, size and spacing for EPUB.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. There’s no sign-up and nothing leaves your device — your library stays entirely offline and private. No accounts, no servers, no tracking.',
  },
  {
    q: 'Is it on the Play Store yet?',
    a: 'Not yet. revpdf is in development, so for now you can download the APK and install it directly. The Play Store listing is coming soon.',
  },
  {
    q: 'How do I get started?',
    a: 'Download the APK, install it, then open any PDF or EPUB from your device and start reading in seconds.',
  },
];
---

<Layout>
  <!-- Hero (ui1) -->
  <section class="hero">
    <h1 class="reveal">
      Meet revpdf, your<br />
      <em>quiet reader.</em>
    </h1>
    <p class="hero-sub reveal">A minimalist PDF &amp; EPUB reader that stays out of your way.</p>
    <a class="btn btn-glass hero-btn reveal" href={APK_URL} download>
      <span class="material-symbols-outlined">android</span>
      Download
    </a>

    <div class="hero-phone reveal">
      <div class="phone-frame">
        <img src={heroShot} alt="revpdf reading screen" width="300" height="633" />
      </div>
    </div>
  </section>

  <!-- Testimonial (ui2) -->
  <section class="quote section">
    <div class="quote-avatar reveal" aria-hidden="true"></div>
    <blockquote class="reveal">
      “revpdf is the best”
    </blockquote>
    <cite class="reveal"> - Bikash</cite>
  </section>

  <!-- Features / Connect with your library (ui3) -->
  <section class="connect section" id="features">
    <div class="connect-copy reveal">
      <h2>Built around the page.</h2>
      <p class="lead">
        revpdf adapts to the way you read, not the other way around. Quiet by default, powerful when
        you need it.
      </p>
      <ul class="feature-list">
        {
          features.map((f) => (
            <li>
              <span class="feature-icon material-symbols-outlined">{f.icon}</span>
              <span class="feature-title">{f.title}</span>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-dark" href={APK_URL} download>
        <span class="material-symbols-outlined">android</span>
        Download APK
      </a>
    </div>
    <div class="connect-visual reveal" aria-hidden="true">
      <!-- image placeholder — to be added later -->
    </div>
  </section>

  <!-- FAQ (faq.png) -->
  <section class="faq section" id="faq">
    <h2 class="faq-title">FAQs</h2>
    <div class="faq-list">
      {
        faqs.map((item, i) => (
          <details class="faq-item reveal" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq-icon material-symbols-outlined" />
            </summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- CTA — Bring your library along (ui4) -->
  <section class="cta-band" id="download">
    <div class="cta-inner reveal">
      <h2>Bring your library along.</h2>
      <p>Import a PDF or EPUB and start reading in seconds. No sign-up, no upload.</p>
      <a class="btn btn-light" href={APK_URL} download>
        <span class="material-symbols-outlined">android</span>
        Download APK
      </a>
      <p class="cta-fine">
        Currently in development — Play Store coming soon. Questions or bug reports?{' '}
        <a href={`mailto:${CONTACT_EMAIL}?subject=revpdf%20feedback`}>{CONTACT_EMAIL}</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  // Blur-in reveal on load + as elements scroll into view.
  const els = document.querySelectorAll('.reveal');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) {
    els.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ---------- Hero (ui1) ---------- */
  .hero {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 48px) clamp(16px, 5vw, 44px) 0;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(38px, 6vw, 66px);
    font-weight: 500;
    margin-bottom: 18px;
  }
  .hero h1 em {
    font-style: italic;
    font-weight: 500;
  }
  .hero-sub {
    font-size: clamp(15px, 1.8vw, 18px);
    color: var(--body);
    max-width: none;
    margin: 0 auto 24px;
  }
  .hero-btn {
    padding: 13px 26px;
    font-size: 15px;
  }
  .hero-fine {
    font-size: 12.5px;
    color: var(--muted);
    margin: 14px 0 0;
  }
  .hero-phone {
    margin-top: clamp(20px, 3vw, 36px);
    display: flex;
    justify-content: center;
  }
  .phone-frame {
    width: min(270px, 68vw);
    background: #11131a;
    border-radius: 40px;
    padding: 11px;
    box-shadow: var(--shadow-2);
  }
  .phone-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 30px;
  }

  /* ---------- Testimonial (ui2) ---------- */
  .quote {
    text-align: center;
    max-width: 900px;
    /* extra breathing room above + below the testimonial */
    padding-block: clamp(88px, 13vw, 176px);
  }
  .quote-avatar {
    width: 100px;
    height: 100px;
    margin: 0 auto 32px;
    border-radius: 22px;
    background: linear-gradient(160deg, #e9eaef, #d9dbe4);
    box-shadow: var(--shadow-2);
  }
  .quote blockquote {
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(23px, 3.4vw, 40px);
    line-height: 1.2;
    color: var(--ink);
    margin: 0 auto;
    max-width: 20ch;
    letter-spacing: -0.015em;
  }
  .quote cite {
    display: block;
    margin-top: 28px;
    font-style: normal;
    font-size: 15px;
    color: var(--muted);
  }

  /* ---------- Connect / features (ui3) ---------- */
  .connect {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .connect-copy h2 {
    font-size: clamp(28px, 3.6vw, 44px);
  }
  .connect-copy .lead {
    font-size: clamp(15px, 1.8vw, 18px);
    max-width: 42ch;
    margin-bottom: 24px;
  }
  .feature-list {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
  }
  .feature-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 15px 4px;
    border-top: 1px solid var(--line);
  }
  .feature-list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .feature-icon {
    font-size: 22px;
    color: var(--ink-soft);
  }
  .feature-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
  }
  .connect-visual {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 120% at 30% 20%, #eef0f6 0%, #e2e5ee 55%, #d7dae6 100%);
    box-shadow: var(--shadow-1);
  }

  /* ---------- FAQ ---------- */
  .faq {
    max-width: 760px;
  }
  .faq-title {
    text-align: center;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 500;
    margin-bottom: clamp(20px, 3vw, 32px);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
    /* same horizontal padding open + closed so all question text lines up */
    padding: 2px 20px;
    transition: background 0.2s ease;
  }
  .faq-item[open] {
    background: var(--card);
    border-bottom-color: transparent;
    border-radius: 16px;
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 15px 0;
    font-size: clamp(15px, 1.7vw, 17px);
    font-weight: 600;
    color: var(--ink);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    flex-shrink: 0;
    font-size: 22px;
    color: var(--ink-soft);
  }
  .faq-icon::before {
    content: 'add';
  }
  .faq-item[open] .faq-icon::before {
    content: 'remove';
  }
  .faq-answer {
    margin: 0;
    padding: 0 36px 18px 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--body);
    max-width: 62ch;
  }

  /* ---------- CTA band (ui4) ---------- */
  .cta-band {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 clamp(16px, 5vw, 44px) clamp(56px, 9vw, 110px);
  }
  .cta-inner {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--dark);
    color: #fff;
    text-align: center;
    padding: clamp(56px, 8vw, 104px) clamp(20px, 6vw, 48px);
  }
  /* low-opacity background photo behind the dark overlay */
  .cta-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1507842217343-583bb7270b66?auto=format&fit=crop&w=1600&q=60');
    background-size: cover;
    background-position: center;
    opacity: 0.22;
    z-index: 0;
  }
  .cta-inner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 140% at 50% 0%, rgba(28, 44, 74, 0.35) 0%, var(--dark) 78%);
    z-index: 1;
  }
  .cta-inner > * {
    position: relative;
    z-index: 2;
  }
  .cta-inner h2 {
    color: #fff;
    font-size: clamp(30px, 4.5vw, 52px);
    font-weight: 500;
    margin-bottom: 14px;
  }
  .cta-inner p {
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(15px, 1.8vw, 17px);
    max-width: 44ch;
    margin: 0 auto 26px;
  }
  .cta-fine {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.6) !important;
    margin: 28px auto 0 !important;
  }
  .cta-fine a {
    color: rgba(255, 255, 255, 0.92);
    font-weight: 500;
    text-decoration: underline;
  }

  /* ---------- animations ---------- */
  @media (prefers-reduced-motion: no-preference) {
    /* blur-in reveal (on load for above-the-fold, on scroll for the rest) */
    .reveal {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(16px);
      transition:
        opacity 0.7s ease,
        filter 0.7s ease,
        transform 0.7s ease;
      will-change: opacity, filter, transform;
    }
    .reveal.in {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
    /* gentle stagger for the hero stack */
    .hero > .reveal:nth-child(2) {
      transition-delay: 0.07s;
    }
    .hero > .reveal:nth-child(3) {
      transition-delay: 0.14s;
    }
    .hero > .reveal:nth-child(4) {
      transition-delay: 0.21s;
    }

    /* blur-then-display when an FAQ item is opened */
    .faq-item[open] .faq-answer {
      animation: faq-reveal 0.4s ease both;
    }
  }
  @keyframes faq-reveal {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 820px) {
    .connect {
      grid-template-columns: 1fr;
    }
    .connect-visual {
      order: -1;
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 520px) {
    .hero-btn,
    .connect-copy .btn {
      width: 100%;
    }
  }
</style>
